{
  "name": "healthcare-pricing-backend",
  "version": "1.0.0",
  "description": "Express.js API for healthcare price transparency platform",
  "main": "src/server.ts",
  "scripts": {
    "dev": "ts-node -r dotenv/config src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:search": "jest searchService",
    "test:integration": "jest search.integration.test",
    "test:coverage": "jest --coverage",
    "db:migrate": "supabase migration up",
    "db:reset": "supabase db reset",
    "db:seed": "ts-node src/db/seed.ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "healthcare",
    "pricing",
    "transparency",
    "supabase"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mssql": "^12.2.1",
    "pg": "^8.20.0",
    "pino": "^8.17.2",
    "pino-http": "^8.5.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/mssql": "^9.1.11",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
